#!/usr/bin/env php
<?php

declare(strict_types=1);

use Bedriox\Api\World\WorldDimension;
use Bedriox\Data\PersistentBlockStateRegistry;
use Bedriox\Server\Entity\Persistence\CorruptEntityPersistenceException;
use Bedriox\Server\Entity\Persistence\EntityChunkSnapshot;
use Bedriox\Server\Entity\Persistence\EntityOwnershipTransfer;
use Bedriox\Server\Entity\Persistence\EntityOwnershipTransferResult;
use Bedriox\Server\Entity\Persistence\EntityPersistenceConflictException;
use Bedriox\Server\Entity\Persistence\EntityPersistenceStore;
use Bedriox\Server\Persistence\World\Internal\WorldStorageProcessProgram;
use Bedriox\Server\Persistence\World\WorldStorageStartup;
use Bedriox\Server\Tests\World\InMemoryWorldProvider;
use Bedriox\Server\World\Block\BlockStateRegistry;
use Bedriox\Server\World\ChunkPosition;
use Bedriox\Server\World\Provider\ChunkSaveData;
use Bedriox\Server\World\Provider\LoadedChunkData;
use Bedriox\Server\World\Provider\WorldData;
use Bedriox\Server\World\Provider\WritableWorldProvider;
use Bedriox\Server\World\SpawnPosition;
use Bedriox\Server\World\WorldMetadata;

require dirname(__DIR__, 2) . '/vendor/autoload.php';

exit(WorldStorageProcessProgram::run(
    $argv[2] ?? '',
    $argv[3] ?? '',
    $argv[4] ?? '',
    $argv[5] ?? '',
    static function (
        WorldStorageStartup $startup,
        BlockStateRegistry $_states,
        PersistentBlockStateRegistry $_persistentStates,
    ): WritableWorldProvider {
        if (str_contains($startup->path, 'slow-start')) {
            usleep(1_500_000);
        }
        $data = $startup->createData ?? new WorldData(
            new WorldMetadata('fixture', 1),
            'flat',
            new SpawnPosition(0, 64, 0),
        );
        $inner = new InMemoryWorldProvider($data);
        if (str_contains($startup->path, 'corrupt')) {
            $inner->corruptChunks['0:0'] = true;
        }
        $delayLoads = str_contains($startup->path, 'timeout');
        $delaySaves = str_contains($startup->path, 'slow-save');

        return new class ($inner, $delayLoads, $delaySaves, str_contains($startup->path, 'entity-corrupt')) implements WritableWorldProvider, EntityPersistenceStore {
            /** @var array<string, EntityChunkSnapshot> */
            private array $entitySnapshots = [];

            public function __construct(
                private InMemoryWorldProvider $inner,
                private bool $delayLoads,
                private bool $delaySaves,
                private bool $corruptEntities,
            ) {}

            public function worldData(): WorldData
            {
                return $this->inner->worldData();
            }

            public function loadChunk(
                ChunkPosition $position,
                WorldDimension $dimension = WorldDimension::OVERWORLD,
            ): ?LoadedChunkData
            {
                if ($this->delayLoads) {
                    usleep(500_000);
                }

                return $this->inner->loadChunk($position, $dimension);
            }

            public function saveWorldData(WorldData $worldData): void
            {
                $this->inner->saveWorldData($worldData);
            }

            public function saveChunk(
                ChunkSaveData $chunkData,
                WorldDimension $dimension = WorldDimension::OVERWORLD,
            ): void
            {
                if ($this->delaySaves) {
                    usleep(500_000);
                }
                $this->inner->saveChunk($chunkData, $dimension);
            }

            public function loadEntityChunk(
                ChunkPosition $position,
                WorldDimension $dimension = WorldDimension::OVERWORLD,
            ): ?EntityChunkSnapshot
            {
                if ($this->corruptEntities && $position->x === 0 && $position->z === 0) {
                    throw new CorruptEntityPersistenceException($position);
                }

                return $this->entitySnapshots[$dimension->value . ':' . $position->key()] ?? null;
            }

            public function saveEntityChunk(
                EntityChunkSnapshot $snapshot,
                WorldDimension $dimension = WorldDimension::OVERWORLD,
            ): void
            {
                $key = $dimension->value . ':' . $snapshot->chunk->key();
                $current = $this->entitySnapshots[$key] ?? null;
                if ($current instanceof EntityChunkSnapshot && $snapshot->chunkRevision <= $current->chunkRevision) {
                    throw new EntityPersistenceConflictException('Injected stale entity snapshot.');
                }
                $this->entitySnapshots[$key] = $snapshot;
            }

            public function transferEntityOwnership(
                EntityOwnershipTransfer $transfer,
                WorldDimension $dimension = WorldDimension::OVERWORLD,
            ): EntityOwnershipTransferResult
            {
                $prefix = $dimension->value . ':';
                $source = $this->entitySnapshots[$prefix . $transfer->sourceAfter->chunk->key()] ?? null;
                if (!$source instanceof EntityChunkSnapshot
                    || !$source->containsExactRevision($transfer->uuid, $transfer->expectedEntityRevision)) {
                    throw new EntityPersistenceConflictException('Injected stale entity transfer.');
                }
                $this->entitySnapshots[$prefix . $transfer->sourceAfter->chunk->key()] = $transfer->sourceAfter;
                $this->entitySnapshots[$prefix . $transfer->destinationAfter->chunk->key()] = $transfer->destinationAfter;

                return new EntityOwnershipTransferResult($transfer->sourceAfter, $transfer->destinationAfter);
            }

            public function close(): void
            {
                $this->inner->close();
            }
        };
    },
));
